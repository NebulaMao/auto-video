# AutoVideo 配置文件 - SiliconFlow TTS 示例
# 请根据实际情况修改以下配置

# ==================== 应用程序基本配置 ====================
[app]
name = "AutoVideo"
version = "0.1.0"
debug = false  # 调试模式
language = "zh-CN"  # 界面语言

# ==================== DeepSeek LLM配置 ====================
[llm]
api_key = "sk-286e0a3cfbd5fd2b526879a15032e80e"  # 请填入你的DeepSeek API密钥
base_url = "https://apis.iflow.cn/v1"  # API基础URL
model = "deepseek-v3.2"  # 使用的模型名称
max_tokens = 4000  # 最大生成token数
temperature = 0.7  # 生成温度(0-1)
timeout = 30  # API请求超时时间(秒)

# ==================== TTS语音合成配置 ====================
[tts]
engine = "siliconflow"  # TTS引擎: edge-tts, siliconflow, pyttsx3, azure-tts
voice = "fnlp/MOSS-TTSD-v0.5:alex"  # 语音名称
rate = 1.0  # 语速倍率(0.5-2.0)
volume = 1.0  # 音量倍率(0.0-2.0)
pitch = 0  # 音调偏移(-100到100 Hz)
segment_by_punctuation = true  # 是否按标点符号分段TTS
min_segment_length = 10  # 最小段落长度(字符)
max_segment_length = 50  # 最大段落长度(字符)
segment_pause = 0.5  # 段落间停顿时间(秒)

# ==================== SiliconFlow TTS 配置 ====================
[siliconflow_tts]
api_key = "your-siliconflow-api-key-here"  # SiliconFlow API密钥，请填入你的API密钥
base_url = "https://api.siliconflow.cn/v1"  # API基础URL
model = "fnlp/MOSS-TTSD-v0.5"  # 模型名称
voice = "fnlp/MOSS-TTSD-v0.5:alex"  # 语音名称
response_format = "mp3"  # 响应格式: mp3, opus, wav, pcm
sample_rate = 32000  # 采样率
speed = 1.0  # 语速倍率(0.25-4.0)
gain = 0  # 音量增益(-10到10)
stream = false  # 是否流式响应
timeout = 30  # API请求超时时间(秒)

# ==================== 视频处理配置 ====================
[video]
backend = "moviepy"
resolution = [1080, 1920]  # 分辨率 [宽度, 高度]
fps = 30  # 帧率
codec = "libx264"  # 视频编码器
bitrate = "2000k"  # 视频比特率
audio_codec = "aac"  # 音频编码器
audio_bitrate = "128k"  # 音频比特率
format = "mp4"  # 输出格式

# ==================== 字幕样式配置 ====================
[subtitle]
font_family = "./assets/fonts/ZiZhiQuXiMaiTi-2.ttf"  # 字体文件路径
font_size = 48  # 字体大小(像素)
font_color = "#FFFFFF"  # 字体颜色(白色)
background_color = "#000000"  # 背景颜色(黑色)
background_alpha = 0.0  # 背景透明度(0-1, 0为完全透明即无背景)
position = "bottom"  # 位置: top, center, bottom
margin = 800  # 边距(像素)
alignment = "center"  # 对齐方式: left, center, right
outline_color = "#000000"  # 描边颜色(黑色)
outline_width = 2  # 描边宽度(像素)
max_width = 0.85  # 最大宽度比例(0-1)

# ==================== 路径配置 ====================
[paths]
materials_dir = "./data/materials"  # 素材库目录
output_dir = "./data/output"  # 输出目录
temp_dir = "./data/temp"  # 临时文件目录
fonts_dir = "./assets/fonts"  # 字体文件目录
templates_dir = "./assets/templates"  # 视频模板目录

# ==================== 日志配置 ====================
[logging]
level = "INFO"  # 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
format = "%(asctime)s - %(name)s - %(levelname)s - %(message)s"  # 日志格式
file = "./logs/autovideo.log"  # 日志文件路径
max_size = "10MB"  # 单个日志文件最大大小
backup_count = 5  # 保留的日志文件数量

# ==================== 素材检索配置 ====================
[material_search]
semantic_similarity_threshold = 0.7  # 语义相似度阈值(0-1)
max_results = 10  # 最大返回结果数
supported_formats = [".mp4", ".avi", ".mov", ".mkv", ".wmv", ".flv", ".webm", ".m4v", ".3gp", ".ogv", ".ts", ".mts", ".m2ts", ".jpg", ".jpeg", ".png", ".bmp", ".gif", ".tiff", ".webp"]  # 支持的素材格式
embedding_model = "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"  # 语义匹配模型

# ==================== Gradio界面配置 ====================
[ui]
title = "AutoVideo - 自动化宣传视频生成系统"  # 界面标题
description = "基于AI技术的自动化宣传视频生成工具"  # 界面描述
theme = "default"  # 界面主题
share = false  # 是否生成公共分享链接
server_port = 7860  # 服务端口
server_name = "127.0.0.1"  # 服务地址(0.0.0.0表示允许外部访问)